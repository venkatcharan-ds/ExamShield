# Comma-separated list of allowed frontend origins (no trailing slash)
# Development default: http://localhost:3000,http://127.0.0.1:3000
# Production: set this in Render → Environment → ALLOWED_ORIGINS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Same Supabase project URL already public in the frontend's
# NEXT_PUBLIC_SUPABASE_URL — not a secret. Required so the backend can
# verify Supabase-issued bearer tokens (via the project's public JWKS)
# on ConsentPulse's mutation endpoints. Without this, those endpoints
# fail closed with 503 rather than silently accepting requests.
SUPABASE_URL=https://your-project.supabase.co
